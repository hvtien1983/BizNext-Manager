<Window x:Class="ScanApp.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt"
        Width="560"
        Height="620"
        MinWidth="520"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/icon.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cài đặt ứng dụng"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock Text="Thiết lập nơi lưu PDF và máy scan mặc định."
                       Margin="0,5,0,0"
                       FontSize="{StaticResource CompactControlFontSize}"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="18"
                Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="THƯ MỤC LƯU PDF MẶC ĐỊNH"
                           Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PdfDirectoryTextBox"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             AutomationProperties.Name="Thư mục lưu PDF mặc định" />
                    <Button Grid.Column="2"
                            Content="Chọn thư mục..."
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowsePdfDirectory_Click" />
                </Grid>
                <TextBlock Text="File PDF mới sẽ được lưu vào thư mục này."
                           Margin="1,5,0,0"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <TextBlock Text="MÁY SCAN MẶC ĐỊNH"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,20,0,5" />
                <ComboBox x:Name="DefaultScannerComboBox"
                          Style="{StaticResource InputComboBox}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="DeviceId"
                          AutomationProperties.Name="Máy scan mặc định" />
                <TextBlock x:Name="ScannerHelpText"
                           Text="Chỉ hiển thị máy scan đã có bí danh/cấu hình trong ứng dụng."
                           Margin="1,5,0,0"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />

                <CheckBox x:Name="AppendTimestampCheckBox"
                          Margin="0,22,0,0"
                          FontSize="{StaticResource CompactControlFontSize}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Content="Tự thêm thời gian vào tên file để tránh trùng"
                          AutomationProperties.Name="Tự thêm thời gian vào tên file PDF" />
                <TextBlock Text="Định dạng: yyyy-MM-dd_hh-mm-ss.pdf"
                           Margin="22,4,0,0"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <TextBlock Text="CHỦ ĐỀ"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,20,0,5" />
                <StackPanel>
                    <RadioButton x:Name="LightThemeRadioButton"
                                 GroupName="AppTheme"
                                 Content="Màu Sáng"
                                 Margin="0,3"
                                 FontSize="{StaticResource CompactControlFontSize}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="Chủ đề Màu Sáng" />
                    <RadioButton x:Name="DarkThemeRadioButton"
                                 GroupName="AppTheme"
                                 Content="Màu Tối"
                                 Margin="0,3"
                                 FontSize="{StaticResource CompactControlFontSize}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="Chủ đề Màu Tối" />
                    <RadioButton x:Name="SystemThemeRadioButton"
                                 GroupName="AppTheme"
                                 Content="Theo hệ thống"
                                 Margin="0,3"
                                 FontSize="{StaticResource CompactControlFontSize}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="Chủ đề Theo hệ thống" />
                </StackPanel>
                <TextBlock Text="Theo cài đặt giao diện ứng dụng của Windows mỗi khi mở ứng dụng."
                           Margin="22,2,0,0"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Hủy"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Lưu cài đặt"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="110"
                    IsDefault="True"
                    Click="SaveSettings_Click" />
        </StackPanel>
    </Grid>
</Window>
