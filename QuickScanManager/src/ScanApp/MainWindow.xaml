<Window x:Class="ScanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QuickScanManager"
        Width="1380"
        Height="900"
        MinWidth="1050"
        MinHeight="720"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        Foreground="#172033"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#356AE6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#748099" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E9F0" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#536078" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#34415A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AppTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#748099" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="17,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#356AE6" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#356AE6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F4" />
            <Setter Property="RowHeight" Value="48" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E9EDF3"
                BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#EAF0FF">
                        <TextBlock Text="Q"
                                   Foreground="#356AE6"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QuickScanManager"
                                   FontSize="14"
                                   FontWeight="Bold" />
                        <TextBlock Text="Tài liệu của bạn, gọn gàng một nơi"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="11,6"
                        CornerRadius="15"
                        Background="#F0F7F2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#35A66F"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Sẵn sàng"
                                   Margin="7,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#278354" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,22,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Không gian làm việc"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock Text="Quét tài liệu mới hoặc tìm lại những tệp bạn đã lưu."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <TabControl Background="Transparent"
                            BorderThickness="0"
                            Padding="18,0"
                            ItemContainerStyle="{StaticResource AppTabItem}">
                    <TabItem Header="Quét &amp; Xuất PDF  ·  Scan &amp; Export">
                        <Grid Margin="3,18,3,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thiết lập scan"
                                                   FontSize="15"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Cấu hình nguồn và chất lượng."
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                        <TextBlock Text="MÁY SCAN"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding Scanners}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="DeviceId"
                                                  SelectedValue="{Binding SelectedScannerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="↻ Làm mới"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="32"
                                                    Padding="9,0"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding RefreshScannersCommand}" />
                                            <Button Content="Thêm thiết bị Windows"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="32"
                                                    Padding="8,0"
                                                    Command="{Binding OpenWindowsScannerSettingsCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Margin="0,8,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,7,0,0">
                                            <Button Content="{Binding ProfileButtonText}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30"
                                                    Padding="8,0"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding AddOrEditProfileCommand}" />
                                            <Button Content="Xóa bí danh"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30"
                                                    Padding="8,0"
                                                    Foreground="#C44747"
                                                    Command="{Binding DeleteProfileCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                        <TextBlock Text="CHẾ ĐỘ MÀU"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedColorMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="Màu" Tag="Color" />
                                            <ComboBoxItem Content="Xám" Tag="Grayscale" />
                                            <ComboBoxItem Content="Đen trắng" Tag="BlackWhite" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                                        <TextBlock Text="ĐỘ PHÂN GIẢI"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="{Binding SelectedResolutionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="150 DPI" Tag="150" />
                                            <ComboBoxItem Content="200 DPI" Tag="200" />
                                            <ComboBoxItem Content="300 DPI" Tag="300" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,15,0,0">
                                        <TextBlock Text="NGUỒN NẠP"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedSource, Mode=TwoWay}">
                                            <ComboBoxItem Content="Mặt kính" Tag="Flatbed" />
                                            <ComboBoxItem Content="Khay nạp ADF" Tag="Feeder" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6">
                                        <Button Content="▣   Quét trang"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,0,8" />
                                        <Button Content="▤   Quét hàng loạt"
                                                Style="{StaticResource SecondaryButton}" />
                                        <TextBlock Text="Quét hàng loạt khả dụng với khay ADF."
                                                   Margin="0,9,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Xem trước trang"
                                                       FontSize="15"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kiểm tra và sắp xếp trang trước khi lưu."
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="9,5"
                                                CornerRadius="12"
                                                Background="#F2F5FA"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="0 trang"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#59667D" />
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Margin="0,15,0,14"
                                            CornerRadius="9"
                                            BorderBrush="#E8ECF3"
                                            BorderThickness="1"
                                            Background="#F8FAFD">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Border Width="60"
                                                    Height="60"
                                                    CornerRadius="17"
                                                    Background="#EEF3FF"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="▤"
                                                           FontSize="28"
                                                           Foreground="#6C8CE8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Chưa có trang xem trước"
                                                       Margin="0,15,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Quét trang hoặc thêm ảnh/PDF để bắt đầu."
                                                       Margin="0,6,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Grid.Row="2"
                                               HorizontalAlignment="Center">
                                        <Button Content="↶  Xoay trái"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3"
                                                IsEnabled="False" />
                                        <Button Content="↷  Xoay phải"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3"
                                                IsEnabled="False" />
                                        <Button Content="↑  Lên"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3"
                                                IsEnabled="False" />
                                        <Button Content="↓  Xuống"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3"
                                                IsEnabled="False" />
                                        <Button Content="Xóa trang"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3"
                                                IsEnabled="False" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource SectionCard}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Danh sách trang"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kéo để sắp xếp thứ tự."
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="0"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,13,0,13"
                                            CornerRadius="8"
                                            BorderBrush="#E8ECF3"
                                            BorderThickness="1"
                                            Background="#FBFCFE">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Chưa có trang"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#59667D"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Các trang đã quét sẽ hiện tại đây."
                                                       Margin="0,5,0,0"
                                                       FontSize="9"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Width="190" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="THÔNG TIN PDF"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#536078"
                                                   Margin="0,0,0,11" />
                                        <TextBlock Text="TÊN FILE PDF"
                                                   Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource InputTextBox}"
                                                 ToolTip="Nhập tên file PDF" />
                                        <TextBlock Text="DANH MỤC"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,13,0,7" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Chọn danh mục..." />
                                            <ComboBoxItem Content="Cá nhân" />
                                            <ComboBoxItem Content="Công việc" />
                                            <ComboBoxItem Content="Khác" />
                                        </ComboBox>
                                        <TextBlock Text="TAG"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,13,0,7" />
                                        <TextBox Style="{StaticResource InputTextBox}"
                                                 ToolTip="Ví dụ: hợp đồng, hóa đơn..." />
                                        <Button Content="Lưu thành PDF"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,16,0,0"
                                                IsEnabled="False"
                                                Opacity="0.55" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Tệp đã quét  ·  Scanned Files">
                        <Grid Margin="3,18,3,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SectionCard}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TÌM KIẾM"
                                                   Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SearchBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 ToolTip="Tìm theo tên file, tag hoặc ghi chú" />
                                        <TextBlock Text="Tìm theo tên file, tag hoặc ghi chú"
                                                   Margin="1,5,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DANH MỤC"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Tất cả danh mục" />
                                            <ComboBoxItem Content="Cá nhân" />
                                            <ComboBoxItem Content="Công việc" />
                                            <ComboBoxItem Content="Khác" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="THỜI GIAN"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Tất cả thời gian" />
                                            <ComboBoxItem Content="Tháng này" />
                                            <ComboBoxItem Content="Tháng trước" />
                                            <ComboBoxItem Content="Năm nay" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="6"
                                            Content="↻  Làm mới"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,19,0,0" />
                                    <Button Grid.Column="8"
                                            Content="Mở thư mục lưu trữ"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,19,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <DataGrid x:Name="LibraryGrid"
                                                  Style="{StaticResource LibraryDataGrid}"
                                                  Margin="10,7">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="TÊN FILE"
                                                                    Width="2.1*"
                                                                    Binding="{Binding Name}" />
                                                <DataGridTextColumn Header="DANH MỤC"
                                                                    Width="1.1*"
                                                                    Binding="{Binding Category}" />
                                                <DataGridTextColumn Header="SỐ TRANG"
                                                                    Width="0.8*"
                                                                    Binding="{Binding PageCount}" />
                                                <DataGridTextColumn Header="DUNG LƯỢNG"
                                                                    Width="1*"
                                                                    Binding="{Binding FileSize}" />
                                                <DataGridTextColumn Header="NGÀY QUÉT"
                                                                    Width="1.2*"
                                                                    Binding="{Binding ScannedAt}" />
                                                <DataGridTextColumn Header="TAG"
                                                                    Width="1.4*"
                                                                    Binding="{Binding Tags}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Margin="0,16,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=LibraryGrid}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="54"
                                                    Height="54"
                                                    CornerRadius="16"
                                                    Background="#F2F5FA"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="▱"
                                                           FontSize="28"
                                                           Foreground="#8A96AA"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Thư viện của bạn đang trống"
                                                       Margin="0,13,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Các file PDF đã lưu sẽ xuất hiện tại đây."
                                                       Margin="0,5,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Padding="14,10"
                                            BorderBrush="#EEF0F4"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <TextBlock Text="Chọn một file để xem thông tin chi tiết."
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="0 tài liệu"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                                    Style="{StaticResource SectionCard}"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="THAO TÁC NHANH"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="Mở, quản lý hoặc xóa file đã chọn."
                                                   Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="#536078" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               VerticalAlignment="Center">
                                        <Button Content="Mở file PDF"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="4,0"
                                                IsEnabled="False" />
                                        <Button Content="Mở vị trí file"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="4,0"
                                                IsEnabled="False" />
                                        <Button Content="Đổi tên / Sửa tag"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="4,0"
                                                IsEnabled="False" />
                                        <Button Content="Xóa file"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="4,0"
                                                Foreground="#C44747"
                                                IsEnabled="False" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
