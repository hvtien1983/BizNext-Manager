<Window x:Class="ScanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScanApp.ViewModels"
        xmlns:controls="clr-namespace:ScanApp.Controls"
        mc:Ignorable="d"
        Title="BizNext PDF Manager"
        Width="1440"
        Height="948"
        MinWidth="1080"
        MinHeight="720"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen" 
        Icon="Assets/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceHeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46"
                            Height="46"
                            Padding="3"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource SurfaceDefaultBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <Image Source="assets/icon.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               AutomationProperties.Name="BizNext" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BizNext PDF Manager"
                                   FontSize="15"
                                   FontWeight="Bold" />
                        <TextBlock Text="Tài liệu của bạn, gọn gàng một nơi"
                                   Margin="0,2,0,0"
                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            KeyboardNavigation.TabNavigation="Local">
                    <RadioButton GroupName="MainNavigation"
                                 IsChecked="{Binding IsSelected, ElementName=ScanTab, Mode=TwoWay}"
                                 Style="{StaticResource MainNavigationTab}"
                                 AutomationProperties.Name="Quét PDF">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Source="assets/geometric-reading-scan.svg"
                                              Width="17"
                                              Height="17"
                                              Margin="0,0,8,0"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Quét PDF" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MainNavigation"
                                 IsChecked="{Binding IsSelected, ElementName=LibraryTab, Mode=TwoWay}"
                                 Style="{StaticResource MainNavigationTab}"
                                 AutomationProperties.Name="Thư viện PDF">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Source="assets/files.svg"
                                              Width="17"
                                              Height="17"
                                              Margin="0,0,8,0"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Thư viện PDF" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Click="OpenAppSettings_Click"
                        AutomationProperties.Name="Cài đặt ứng dụng">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Source="assets/geometric-settings.svg"
                                          Width="16"
                                          Height="16"
                                          Margin="0,0,7,0"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Cài đặt" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    KeyboardNavigation.TabNavigation="Local">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="ScanTab" Header="Quét PDF" IsSelected="True">
                <Grid Margin="10">

                    <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="272" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thiết lập quét"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Cấu hình nguồn và chất lượng."
                                                   Margin="0,3,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                        <TextBlock Text="MÁY SCAN"
                                                   Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <ComboBox Style="{StaticResource InputComboBox}"
                                                      IsEnabled="{Binding CanChangeScanConfiguration}"
                                                      ItemsSource="{Binding Scanners}"
                                                      ItemContainerStyle="{StaticResource ScannerOptionItem}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="DeviceId"
                                                      SelectedValue="{Binding SelectedScannerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Chưa chọn máy scan"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource CompactControlFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedScanner}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding ProfileButtonText}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Grid.Column="0"
                                                    Padding="5,0"
                                                    Command="{Binding AddOrEditProfileCommand}" />
                                            <Button Content="Xóa bí danh"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Grid.Column="2"
                                                    Padding="5,0"
                                                    Foreground="{DynamicResource TextDangerBrush}"
                                                    Command="{Binding DeleteProfileCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                                        <TextBlock Text="CHẾ ĐỘ MÀU"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedColorMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="Màu" Tag="Color" />
                                            <ComboBoxItem Content="Xám" Tag="Grayscale" />
                                            <ComboBoxItem Content="Đen trắng" Tag="BlackWhite" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,11,0,0">
                                        <TextBlock Text="ĐỘ PHÂN GIẢI"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedIndex="{Binding SelectedResolutionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="150 DPI" Tag="150" />
                                            <ComboBoxItem Content="200 DPI" Tag="200" />
                                            <ComboBoxItem Content="300 DPI" Tag="300" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,11,0,0">
                                        <TextBlock Text="NGUỒN NẠP"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedSource, Mode=TwoWay}">
                                            <ComboBoxItem Content="Mặt kính" Tag="Flatbed" />
                                            <ComboBoxItem Content="Khay nạp ADF" Tag="Feeder" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,0,6"
                                                Command="{Binding ScanPageCommand}"
                                                AutomationProperties.Name="Quét trang">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="assets/cartoon-file-scan.svg"
                                                                  Width="17"
                                                                  Height="17"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Quét trang" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                IsEnabled="{Binding CanBatchScan}"
                                                Command="{Binding BatchScanCommand}"
                                                AutomationProperties.Name="{Binding BatchScanButtonText}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="assets/sequential-scan.svg"
                                                                  Width="17"
                                                                  Height="17"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding BatchScanButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Margin="0,6,0,0"
                                                Click="AddFiles_Click"
                                                IsEnabled="{Binding CanChangeScanConfiguration}"
                                                AutomationProperties.Name="Thêm ảnh hoặc PDF">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Thêm ảnh / PDF" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding BatchScanAvailabilityMessage}"
                                                   Margin="0,7,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Xem trước trang"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kiểm tra và sắp xếp trang trước khi lưu."
                                                       Margin="0,3,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="8,4"
                                                CornerRadius="{StaticResource PillCornerRadius}"
                                                Background="{DynamicResource SurfaceEmptyBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScanPageCount, StringFormat={}{0} trang}"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Margin="0,12,0,10"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfacePreviewBrush}">
                                        <Grid>
                                            <Image Source="{Binding SelectedPage.Preview}"
                                                   Stretch="Uniform"
                                                   Margin="12"
                                                   AutomationProperties.Name="Bản xem trước trang đã quét">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                            <Border Width="60"
                                                    Height="60"
                                                    CornerRadius="{StaticResource CardCornerRadius}"
                                                    Background="{DynamicResource ActionPrimarySubtleBrush}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="▤"
                                                           FontSize="26"
                                                           Foreground="{DynamicResource ActionPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Chưa có trang xem trước"
                                                       Margin="0,12,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Quét trang hoặc thêm ảnh/PDF để bắt đầu."
                                                       Margin="0,5,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Hỗ trợ PDF, JPG, PNG"
                                                       Margin="0,6,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <WrapPanel Grid.Row="2"
                                               HorizontalAlignment="Center">
                                        <Button Content="↶  Xoay trái"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                IsEnabled="False" />
                                        <Button Content="↷  Xoay phải"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                IsEnabled="False" />
                                        <Button Content="↑  Lên"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                IsEnabled="False" />
                                        <Button Content="↓  Xuống"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                IsEnabled="False" />
                                        <Button Content="Xóa trang"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                IsEnabled="False" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource SectionCard}">
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Danh sách trang"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kéo để sắp xếp thứ tự."
                                                       Margin="0,3,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                               Text="{Binding ScanPageCount}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,10,0,10"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderBrush="{DynamicResource BorderPreviewBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfacePreviewBrush}">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding ScanPages}"
                                                     x:Name="ScanPageList"
                                                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                                     Style="{StaticResource ScanPageListBox}"
                                                     ItemContainerStyle="{StaticResource ScanPageListBoxItem}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="ScanPageList_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="ScanPageList_PreviewMouseMove"
                                                     DragEnter="ScanPageList_DragOver"
                                                     DragOver="ScanPageList_DragOver"
                                                     Drop="ScanPageList_Drop">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="⋮⋮"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Cursor="SizeAll"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       AutomationProperties.Name="Kéo để sắp xếp trang" />
                                                            <Border Grid.Column="1"
                                                                    Width="48"
                                                                    Height="62"
                                                                    Padding="3"
                                                                    Background="{DynamicResource SurfaceDefaultBrush}"
                                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                                <Image Source="{Binding Preview}"
                                                                       Stretch="Uniform" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="{StaticResource CompactLabelFontSize}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="Ảnh đã quét"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="{StaticResource CompactCaptionFontSize}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource ScanPageDeleteButton}"
                                                                    Content="×"
                                                                    ToolTip="Xóa trang"
                                                                    AutomationProperties.Name="Xóa trang khỏi danh sách"
                                                                    Command="{Binding DataContext.DeleteScanPageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScanPageCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Chưa có trang"
                                                       FontSize="{StaticResource CompactLabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Các trang đã quét sẽ hiện tại đây."
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Width="190" />
                                        </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2"
                                                MinHeight="230">
                                        <TextBlock Text="THÔNG TIN PDF"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="TÊN FILE PDF"
                                                   Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource InputTextBox}"
                                                     Padding="9,0,42,0"
                                                     Text="{Binding PdfFileName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Nhập tên file, không cần phần mở rộng .pdf"
                                                     AutomationProperties.Name="Tên file PDF" />
                                            <Border HorizontalAlignment="Right"
                                                    Margin="0,1,1,1"
                                                    Padding="8,0"
                                                    Background="{DynamicResource SurfaceDefaultBrush}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text=".pdf"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="{StaticResource CompactControlFontSize}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="DANH MỤC"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,10,0,5" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding PdfCategories}"
                                                  SelectedItem="{Binding PdfCategory, Mode=TwoWay}" />
                                        <TextBlock Text="TAG"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,10,0,5" />
                                        <TextBox Style="{StaticResource InputTextBox}"
                                                 Text="{Binding PdfTags, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Ví dụ: hợp đồng, hóa đơn..." />
                                        <Button Content="Lưu thành PDF"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,12,0,0"
                                                Command="{Binding SavePdfCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="LibraryTab" Header="Thư viện PDF">
                        <Grid Margin="24,24,24,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SectionCard}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TÌM KIẾM"
                                                   Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SearchBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 ToolTip="Tìm theo tên file, tag hoặc ghi chú" />
                                        <TextBlock Text="Tìm theo tên file, tag hoặc ghi chú"
                                                   Margin="1,4,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DANH MỤC"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Tất cả danh mục" />
                                            <ComboBoxItem Content="Cá nhân" />
                                            <ComboBoxItem Content="Công việc" />
                                            <ComboBoxItem Content="Khác" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="THỜI GIAN"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Tất cả thời gian" />
                                            <ComboBoxItem Content="Tháng này" />
                                            <ComboBoxItem Content="Tháng trước" />
                                            <ComboBoxItem Content="Năm nay" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="6"
                                            Content="↻  Làm mới"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,18,0,0" />
                                    <Button Grid.Column="8"
                                            Content="Mở thư mục lưu trữ"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,18,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <DataGrid x:Name="LibraryGrid"
                                                  Style="{StaticResource LibraryDataGrid}"
                                                  Margin="8,6">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="TÊN FILE"
                                                                    Width="2.1*"
                                                                    Binding="{Binding Name}" />
                                                <DataGridTextColumn Header="DANH MỤC"
                                                                    Width="1.1*"
                                                                    Binding="{Binding Category}" />
                                                <DataGridTextColumn Header="SỐ TRANG"
                                                                    Width="0.8*"
                                                                    Binding="{Binding PageCount}" />
                                                <DataGridTextColumn Header="DUNG LƯỢNG"
                                                                    Width="1*"
                                                                    Binding="{Binding FileSize}" />
                                                <DataGridTextColumn Header="NGÀY QUÉT"
                                                                    Width="1.2*"
                                                                    Binding="{Binding ScannedAt}" />
                                                <DataGridTextColumn Header="TAG"
                                                                    Width="1.4*"
                                                                    Binding="{Binding Tags}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Margin="0,12,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=LibraryGrid}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="{StaticResource CardCornerRadius}"
                                                    Background="{DynamicResource SurfaceEmptyBrush}"
                                                    HorizontalAlignment="Center">
                                                <controls:SvgIcon Source="assets/files.svg"
                                                                  Width="25"
                                                                  Height="25"
                                                                  Foreground="{DynamicResource TextIconBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Thư viện của bạn đang trống"
                                                       Margin="0,10,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Các file PDF đã lưu sẽ xuất hiện tại đây."
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <TextBlock Text="Chọn một file để xem thông tin chi tiết."
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="0 tài liệu"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                                    Style="{StaticResource SectionCard}"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="THAO TÁC NHANH"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Mở, quản lý hoặc xóa file đã chọn."
                                                   Margin="0,2,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               VerticalAlignment="Center">
                                        <Button Content="Mở file PDF"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3,0"
                                                IsEnabled="False" />
                                        <Button Content="Mở vị trí file"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3,0"
                                                IsEnabled="False" />
                                        <Button Content="Đổi tên / Sửa tag"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3,0"
                                                IsEnabled="False" />
                                        <Button Content="Xóa file"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="3,0"
                                                Foreground="{DynamicResource TextDangerBrush}"
                                                IsEnabled="False" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="●"
                           FontSize="10"
                           Margin="0,0,8,0"
                           Style="{StaticResource StatusMessageText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Style="{StaticResource StatusMessageText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
