<Window x:Class="ScanApp.ScannerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình máy scan"
        Width="440"
        Height="510"
        MinWidth="420"
        MinHeight="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="DialogComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        </Style>
        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DialogButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DialogButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DialogButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DialogButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Bí danh &amp; mặc định"
                       FontSize="19"
                       FontWeight="Bold" />
            <TextBlock x:Name="DeviceNameText"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="TÊN GỢI NHỚ" Style="{StaticResource DialogLabel}" />
            <TextBox x:Name="AliasTextBox"
                     Style="{StaticResource DialogTextBox}"
                     ToolTip="Ví dụ: Máy scan phòng kế toán" />

            <TextBlock Text="CHẾ ĐỘ MÀU"
                       Style="{StaticResource DialogLabel}"
                       Margin="0,18,0,7" />
            <ComboBox x:Name="ColorModeComboBox" Style="{StaticResource DialogComboBox}">
                <ComboBoxItem Content="Color" Tag="Color" />
                <ComboBoxItem Content="Grayscale" Tag="Grayscale" />
                <ComboBoxItem Content="BlackWhite" Tag="BlackWhite" />
            </ComboBox>

            <TextBlock Text="ĐỘ PHÂN GIẢI"
                       Style="{StaticResource DialogLabel}"
                       Margin="0,18,0,7" />
            <ComboBox x:Name="ResolutionComboBox" Style="{StaticResource DialogComboBox}">
                <ComboBoxItem Content="150 DPI" Tag="150" />
                <ComboBoxItem Content="200 DPI" Tag="200" />
                <ComboBoxItem Content="300 DPI" Tag="300" />
            </ComboBox>

            <TextBlock Text="NGUỒN NẠP"
                       Style="{StaticResource DialogLabel}"
                       Margin="0,18,0,7" />
            <ComboBox x:Name="SourceComboBox" Style="{StaticResource DialogComboBox}">
                <ComboBoxItem Content="Mặt kính" Tag="Flatbed" />
                <ComboBoxItem Content="Khay nạp ADF" Tag="Feeder" />
            </ComboBox>
            <TextBlock Text="Bí danh chỉ lưu trong ứng dụng, không thay đổi tên thiết bị trong Windows."
                       Margin="0,13,0,0"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Hủy"
                    IsCancel="True"
                    Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0"
                    Background="White"
                    BorderBrush="{StaticResource BorderDefaultBrush}" />
            <Button Content="Lưu bí danh"
                    IsDefault="True"
                    Click="Save_Click"
                    Style="{StaticResource DialogButton}"
                    Background="{StaticResource ActionPrimaryBrush}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
