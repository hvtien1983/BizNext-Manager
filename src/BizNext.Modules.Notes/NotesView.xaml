<UserControl x:Class="BizNext.Modules.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceCanvasBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cột 1: Notebook -->
        <Border Grid.Column="0" Style="{DynamicResource SectionCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="+ Notebook"
                        Style="{DynamicResource SecondaryButton}"
                        Command="{Binding NewNotebookCommand}" />

                <!-- Ô nhập tên (hiện khi tạo mới hoặc đổi tên) -->
                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsEditingNotebook, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NotebookEditLabel}"
                               Style="{DynamicResource FieldLabel}"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="NotebookEditBox"
                             Style="{DynamicResource InputTextBox}"
                             Text="{Binding NotebookEditName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmNotebookEditCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelNotebookEditCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Lưu"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding ConfirmNotebookEditCommand}" />
                        <Button Content="Hủy"
                                Style="{DynamicResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Command="{Binding CancelNotebookEditCommand}" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="2"
                         Margin="0,12,0,12"
                         ItemsSource="{Binding NotebookFilters}"
                         SelectedItem="{Binding SelectedNotebookFilter, Mode=TwoWay}"
                         Style="{DynamicResource Fluent.ListBox}"
                         ItemContainerStyle="{DynamicResource Fluent.ListBox.Item}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="8,0,0,0"
                                           Text="{Binding NoteCount}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="Đổi tên"
                            Style="{DynamicResource SecondaryButton}"
                            Command="{Binding RenameNotebookCommand}" />
                    <Button Content="Xóa"
                            Style="{DynamicResource SecondaryButton}"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding IsNotebookSelected}"
                            Click="DeleteNotebookButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cột 2: tìm kiếm và danh sách ghi chú -->
        <Border Grid.Column="2" Style="{DynamicResource SectionCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Content="+ Ghi chú mới"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NewNoteCommand}" />
                    <TextBlock Text="Tìm kiếm"
                               Style="{DynamicResource FieldLabel}"
                               Margin="0,12,0,4" />
                    <TextBox Style="{DynamicResource InputTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding VisibleNotes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         Style="{DynamicResource Fluent.ListBox}"
                         ItemContainerStyle="{DynamicResource Fluent.ListBox.Item}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="📌"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding UpdatedAtDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Cột 3: soạn thảo -->
        <Border Grid.Column="4" Style="{DynamicResource SectionCard}" Padding="20">
            <Grid>
                <TextBlock Text="Chọn một ghi chú hoặc tạo ghi chú mới."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Content="📌 Ghim / Bỏ ghim"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding TogglePinCommand}" />
                        <Button DockPanel.Dock="Left"
                                Content="Xóa"
                                Style="{DynamicResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="DeleteButton_Click" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="200"
                                  Style="{DynamicResource Fluent.ComboBox}"
                                  ItemContainerStyle="{DynamicResource Fluent.ComboBoxItem}"
                                  ItemsSource="{Binding NotebookOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedNote.NotebookKey, Mode=TwoWay}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Notebook:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Style="{DynamicResource InputTextBox}"
                             FontSize="18"
                             FontWeight="Bold"
                             Margin="0,0,0,12"
                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="2"
                             Style="{DynamicResource InputTextBox}"
                             Height="Auto"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>