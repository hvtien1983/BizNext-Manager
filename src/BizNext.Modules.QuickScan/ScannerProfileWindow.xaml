<Window x:Class="BizNext.Modules.QuickScan.ScannerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình máy scan"
        Width="420"
        Height="470"
        MinWidth="400"
        MinHeight="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/icon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Bí danh &amp; mặc định"
                       FontSize="18"
                       FontWeight="Bold" />
            <TextBlock x:Name="DeviceNameText"
                       Margin="0,4,0,0"
                       FontSize="{StaticResource CompactLabelFontSize}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="TÊN GỢI NHỚ" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="AliasTextBox"
                     Style="{StaticResource InputTextBox}"
                     ToolTip="Ví dụ: Máy scan phòng kế toán" />

            <TextBlock Text="CHẾ ĐỘ MÀU"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,12,0,5" />
            <ComboBox x:Name="ColorModeComboBox" Style="{StaticResource Fluent.ComboBox}">
                <ComboBoxItem Content="Color" Tag="Color" />
                <ComboBoxItem Content="Grayscale" Tag="Grayscale" />
                <ComboBoxItem Content="BlackWhite" Tag="BlackWhite" />
            </ComboBox>

            <TextBlock Text="ĐỘ PHÂN GIẢI"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,12,0,5" />
            <ComboBox x:Name="ResolutionComboBox" Style="{StaticResource Fluent.ComboBox}">
                <ComboBoxItem Content="150 DPI" Tag="150" />
                <ComboBoxItem Content="200 DPI" Tag="200" />
                <ComboBoxItem Content="300 DPI" Tag="300" />
            </ComboBox>

            <TextBlock Text="NGUỒN NẠP"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,12,0,5" />
            <ComboBox x:Name="SourceComboBox" Style="{StaticResource Fluent.ComboBox}">
                <ComboBoxItem Content="Mặt kính" Tag="Flatbed" />
                <ComboBoxItem Content="Khay nạp ADF" Tag="Feeder" />
            </ComboBox>
            <TextBlock Text="Bí danh chỉ lưu trong ứng dụng, không thay đổi tên thiết bị trong Windows."
                       Margin="0,10,0,0"
                       FontSize="{StaticResource CompactCaptionFontSize}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Hủy"
                    IsCancel="True"
                    Style="{StaticResource Fluent.Button.Secondary}"
                    Margin="0,0,8,0"
                    MinWidth="90" />
            <Button Content="Lưu bí danh"
                    IsDefault="True"
                    Click="Save_Click"
                    Style="{StaticResource Fluent.Button.Primary}"
                    MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
