<Window x:Class="BizNext.Modules.QuickScan.PdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trình xem PDF"
        Width="1040"
        Height="820"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="PdfViewerWindow_Loaded"
        PreviewKeyDown="PdfViewerWindow_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="10,8"
                Background="{DynamicResource SurfaceDefaultBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PageStatusText"
                               Margin="0,3,0,0"
                               FontSize="{StaticResource CompactCaptionFontSize}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Đang mở PDF..." />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousPageButton"
                            Content="← Trang trước"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="PreviousPage_Click" />
                    <Button x:Name="NextPageButton"
                            Content="Trang sau →"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False"
                            Click="NextPage_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfacePreviewBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
            <ScrollViewer x:Name="PageScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScrollViewer}">
                    <Image x:Name="PageImage"
                           Width="{Binding ViewportWidth, ElementName=PageScrollViewer}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Stretch="Uniform" />
                    <TextBlock x:Name="LoadingText"
                               Text="Đang kết xuất trang PDF..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
