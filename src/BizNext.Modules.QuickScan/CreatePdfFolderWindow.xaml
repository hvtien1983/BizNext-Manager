<Window x:Class="BizNext.Modules.QuickScan.CreatePdfFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo thư mục lưu PDF"
        Width="390"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="TÊN THƯ MỤC MỚI"
                   Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FolderNameTextBox"
                 Grid.Row="1"
                 Style="{StaticResource InputTextBox}"
                 AutomationProperties.Name="Tên thư mục mới" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Hủy"
                    Style="{StaticResource Fluent.Button.Secondary}"
                    Width="82"
                    IsCancel="True" />
            <Button Content="Tạo"
                    Style="{StaticResource Fluent.Button.Primary}"
                    Width="82"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
