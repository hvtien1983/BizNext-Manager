<UserControl x:Class="BizNext.Modules.QuickScan.QuickScanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BizNext.Modules.QuickScan.ViewModels"
        xmlns:controls="clr-namespace:BizNext.Modules.QuickScan.Controls"
        mc:Ignorable="d"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/QuickScanStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Key="PdfLibraryContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Background="{DynamicResource SurfaceDefaultBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Padding" Value="12,7" />
                        <Setter Property="MinWidth" Value="150" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Xem nhanh" Click="QuickViewPdf_Click" />
                <MenuItem Header="Mở vị trí" Click="OpenPdfLocation_Click" />
                <MenuItem Header="Đổi tên" Click="RenamePdf_Click" />
                <Separator />
                <MenuItem Header="Xóa"
                          Foreground="{DynamicResource TextDangerBrush}"
                          Click="DeletePdf_Click" />
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceHeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Local">
                <RadioButton GroupName="MainNavigation"
                             IsChecked="{Binding IsSelected, ElementName=ScanTab, Mode=TwoWay}"
                             Style="{StaticResource MainNavigationTab}"
                             AutomationProperties.Name="Quét PDF">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Source="assets/geometric-reading-scan.svg"
                                          Width="17"
                                          Height="17"
                                          Margin="0,0,8,0"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="Quét PDF" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation"
                             IsChecked="{Binding IsSelected, ElementName=LibraryTab, Mode=TwoWay}"
                             Style="{StaticResource MainNavigationTab}"
                             AutomationProperties.Name="Thư viện PDF">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Source="assets/files.svg"
                                          Width="17"
                                          Height="17"
                                          Margin="0,0,8,0"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="Thư viện PDF" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>


        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    KeyboardNavigation.TabNavigation="Local">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="ScanTab" Header="Quét PDF" IsSelected="True"
                     Foreground="{DynamicResource TextPrimaryBrush}">
                <Grid Margin="6">
                    <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thiết lập quét"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Cấu hình nguồn và chất lượng."
                                                   Margin="0,3,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                        <TextBlock Text="MÁY SCAN"
                                                   Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <ComboBox Style="{StaticResource InputComboBox}"
                                                      IsEnabled="{Binding CanChangeScanConfiguration}"
                                                      ItemsSource="{Binding Scanners}"
                                                      ItemContainerStyle="{StaticResource ScannerOptionItem}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="DeviceId"
                                                      SelectedValue="{Binding SelectedScannerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Chưa chọn máy scan"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource CompactControlFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedScanner}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding ProfileButtonText}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Grid.Column="0"
                                                    Padding="5,0"
                                                    Command="{Binding AddOrEditProfileCommand}" />
                                            <Button Content="Xóa bí danh"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Grid.Column="2"
                                                    Padding="5,0"
                                                    Foreground="{DynamicResource TextDangerBrush}"
                                                    Command="{Binding DeleteProfileCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                                        <TextBlock Text="CHẾ ĐỘ MÀU"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedColorMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="Màu" Tag="Color" />
                                            <ComboBoxItem Content="Xám" Tag="Grayscale" />
                                            <ComboBoxItem Content="Đen trắng" Tag="BlackWhite" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,11,0,0">
                                        <TextBlock Text="ĐỘ PHÂN GIẢI"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedIndex="{Binding SelectedResolutionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="150 DPI" Tag="150" />
                                            <ComboBoxItem Content="200 DPI" Tag="200" />
                                            <ComboBoxItem Content="300 DPI" Tag="300" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,11,0,0">
                                        <TextBlock Text="NGUỒN NẠP"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  IsEnabled="{Binding CanChangeScanConfiguration}"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding SelectedSource, Mode=TwoWay}">
                                            <ComboBoxItem Content="Mặt kính" Tag="Flatbed" />
                                            <ComboBoxItem Content="Khay nạp ADF" Tag="Feeder" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,0,6"
                                                Command="{Binding ScanPageCommand}"
                                                AutomationProperties.Name="Quét trang">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="assets/cartoon-file-scan.svg"
                                                                  Width="17"
                                                                  Height="17"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Quét trang" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                IsEnabled="{Binding CanBatchScan}"
                                                Command="{Binding BatchScanCommand}"
                                                AutomationProperties.Name="{Binding BatchScanButtonText}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="assets/sequential-scan.svg"
                                                                  Width="17"
                                                                  Height="17"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding BatchScanButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding BatchScanAvailabilityMessage}"
                                                   Margin="0,7,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Margin="0,20,0,0"
                                                Click="AddFiles_Click"
                                                IsEnabled="{Binding CanChangeScanConfiguration}"
                                                AutomationProperties.Name="Thêm ảnh hoặc PDF">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="assets/image-up.svg"
                                                                  Width="17"
                                                                  Height="17"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Thêm ảnh / PDF" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Xem trước trang"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kiểm tra và sắp xếp trang trước khi lưu."
                                                       Margin="0,3,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="8,4"
                                                CornerRadius="{StaticResource PillCornerRadius}"
                                                Background="{DynamicResource SurfaceEmptyBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScanPageCount, StringFormat={}{0} trang}"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Margin="0,12,0,10"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfacePreviewBrush}">
                                        <Grid>
                                            <Image Source="{Binding SelectedPage.Preview}"
                                                   Stretch="Uniform"
                                                   Margin="12"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   AutomationProperties.Name="Bản xem trước trang đã quét">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                            <Border Width="60"
                                                    Height="60"
                                                    CornerRadius="{StaticResource CardCornerRadius}"
                                                    Background="{DynamicResource ActionPrimarySubtleBrush}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="▤"
                                                           FontSize="26"
                                                           Foreground="{DynamicResource ActionPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Chưa có trang xem trước"
                                                       Margin="0,12,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Quét trang hoặc thêm ảnh/PDF để bắt đầu."
                                                       Margin="0,5,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Hỗ trợ PDF, JPG, PNG"
                                                       Margin="0,6,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <WrapPanel Grid.Row="2"
                                               HorizontalAlignment="Center">
                                        <Button Content="↶  Xoay trái"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                Command="{Binding RotateSelectedPageLeftCommand}"
                                                ToolTip="Xoay trang sang trái 90 độ"
                                                AutomationProperties.Name="Xoay trang sang trái" />
                                        <Button Content="↷  Xoay phải"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                Command="{Binding RotateSelectedPageRightCommand}"
                                                ToolTip="Xoay trang sang phải 90 độ"
                                                AutomationProperties.Name="Xoay trang sang phải" />
                                        <Button Content="↕  Lật lên/xuống"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                Command="{Binding FlipSelectedPageVerticalCommand}"
                                                ToolTip="Lật trang theo trục ngang"
                                                AutomationProperties.Name="Lật trang lên xuống" />
                                        <Button Content="↔  Lật trái/phải"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="2"
                                                Command="{Binding FlipSelectedPageHorizontalCommand}"
                                                ToolTip="Lật trang theo trục dọc"
                                                AutomationProperties.Name="Lật trang trái phải" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource SectionCard}">
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Danh sách trang"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Kéo để sắp xếp thứ tự."
                                                       Margin="0,3,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                               Text="{Binding ScanPageCount}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,10,0,10"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderBrush="{DynamicResource BorderPreviewBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfacePreviewBrush}">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding ScanPages}"
                                                     x:Name="ScanPageList"
                                                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                                     Style="{StaticResource ScanPageListBox}"
                                                     ItemContainerStyle="{StaticResource ScanPageListBoxItem}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="ScanPageList_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="ScanPageList_PreviewMouseMove"
                                                     DragEnter="ScanPageList_DragOver"
                                                     DragOver="ScanPageList_DragOver"
                                                     Drop="ScanPageList_Drop">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="⋮⋮"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Cursor="SizeAll"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       AutomationProperties.Name="Kéo để sắp xếp trang" />
                                                            <Border Grid.Column="1"
                                                                    Width="48"
                                                                    Height="62"
                                                                    Padding="3"
                                                                    Background="{DynamicResource SurfaceDefaultBrush}"
                                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                                <Image Source="{Binding Preview}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="{StaticResource CompactLabelFontSize}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="Ảnh đã quét"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="{StaticResource CompactCaptionFontSize}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource ScanPageDeleteButton}"
                                                                    Content="×"
                                                                    ToolTip="Xóa trang"
                                                                    AutomationProperties.Name="Xóa trang khỏi danh sách"
                                                                    Command="{Binding DataContext.DeleteScanPageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScanPageCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Chưa có trang"
                                                       FontSize="{StaticResource CompactLabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Các trang đã quét sẽ hiện tại đây."
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Width="190" />
                                        </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2"
                                                MinHeight="230">
                                        <TextBlock Text="THÔNG TIN PDF"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="TÊN FILE PDF"
                                                   Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <TextBox Style="{StaticResource InputTextBox}"
                                                     Padding="9,0,42,0"
                                                     Text="{Binding PdfFileName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Nhập tên file, không cần phần mở rộng .pdf"
                                                     AutomationProperties.Name="Tên file PDF" />
                                            <Border HorizontalAlignment="Right"
                                                    Margin="0,1,1,1"
                                                    Padding="8,0"
                                                    Background="{DynamicResource SurfaceDefaultBrush}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text=".pdf"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="{StaticResource CompactControlFontSize}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="NƠI LƯU"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,10,0,5" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Style="{StaticResource InputComboBox}"
                                                      ItemsSource="{Binding PdfLocations}"
                                                      SelectedItem="{Binding PdfLocation, Mode=TwoWay}"
                                                      AutomationProperties.Name="Nơi lưu PDF" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="0"
                                                    Click="CreatePdfFolder_Click"
                                                    ToolTip="Tạo thư mục mới"
                                                    AutomationProperties.Name="Tạo thư mục lưu PDF">
                                                <TextBlock Text="+"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="CHỌN KHỔ GIẤY"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,10,0,5" />
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding PaperSizes}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedPdfPageSize, Mode=TwoWay}"
                                                  AutomationProperties.Name="Khổ giấy PDF" />
                                        <Button Content="Lưu thành PDF"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,12,0,0"
                                                Command="{Binding SavePdfCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="LibraryTab" Header="Thư viện PDF"
                     Foreground="{DynamicResource TextPrimaryBrush}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SectionCard}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TÌM KIẾM"
                                                   Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SearchBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 TextChanged="SearchBox_TextChanged"
                                                 AutomationProperties.Name="Tìm theo tên tập tin"
                                                 ToolTip="Tìm theo tên tập tin" />
                                        <TextBlock Text="Tìm theo tên tập tin"
                                                   Margin="1,4,0,0"
                                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="THƯ MỤC"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="LibraryFolderComboBox"
                                                  Style="{StaticResource InputComboBox}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="LibraryFolderComboBox_SelectionChanged"
                                                  AutomationProperties.Name="Thư mục PDF" />
                                    </StackPanel>
                                    <Button x:Name="LibraryRefreshButton"
                                            Grid.Column="4"
                                            Content="↻  Làm mới"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,18,0,0"
                                            Click="RefreshLibrary_Click" />
                                    <Button x:Name="OpenLibraryFolderButton"
                                            Grid.Column="6"
                                            Content="Mở trong cửa sổ ngoài"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            Margin="0,18,0,0"
                                            Click="OpenLibraryFolder_Click"
                                            AutomationProperties.Name="Mở thư mục PDF trong cửa sổ ngoài" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SectionCard}"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <DataGrid x:Name="LibraryGrid"
                                                  Style="{StaticResource LibraryDataGrid}"
                                                  Margin="8,6"
                                                  AutomationProperties.Name="Danh sách file PDF và thư mục"
                                                  MouseDoubleClick="LibraryGrid_MouseDoubleClick"
                                                  Sorting="LibraryGrid_Sorting">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow"
                                                       BasedOn="{StaticResource LibraryDataGridRow}">
                                                    <Setter Property="ContextMenu"
                                                            Value="{StaticResource PdfLibraryContextMenu}" />
                                                    <EventSetter Event="ContextMenuOpening"
                                                                 Handler="LibraryGridRow_ContextMenuOpening" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="ContextMenu" Value="{x:Null}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="TÊN TẬP TIN"
                                                                        Width="2.1*"
                                                                        SortMemberPath="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Path x:Name="FolderIcon"
                                                                      Data="M 1,3 L 6,3 L 8,5 L 15,5 L 15,13 L 1,13 Z"
                                                                      Width="14"
                                                                      Height="12"
                                                                      Margin="0,0,7,0"
                                                                      Stretch="Fill"
                                                                      Fill="{DynamicResource TextIconBrush}"
                                                                      Visibility="Collapsed" />
                                                                <Path x:Name="ParentFolderIcon"
                                                                      Data="M 7,13 L 7,6 L 4,9 L 3,8 L 8,3 L 13,8 L 12,9 L 9,6 L 9,13 Z"
                                                                      Width="12"
                                                                      Height="12"
                                                                      Margin="0,0,7,0"
                                                                      Stretch="Fill"
                                                                      Fill="{DynamicResource TextIconBrush}"
                                                                      Visibility="Collapsed" />
                                                                <TextBlock Text="{Binding Name}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter TargetName="FolderIcon"
                                                                            Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsParentNavigation}" Value="True">
                                                                    <Setter TargetName="FolderIcon"
                                                                            Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    <Setter TargetName="ParentFolderIcon"
                                                                            Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="SỐ TRANG"
                                                                        Width="0.75*"
                                                                        SortMemberPath="PageCount"
                                                                        Binding="{Binding PageCount, TargetNullValue='—'}" />
                                                <DataGridTextColumn Header="DUNG LƯỢNG"
                                                                        Width="0.9*"
                                                                        SortMemberPath="SizeBytes"
                                                                        Binding="{Binding SizeDisplay}" />
                                                <DataGridTextColumn Header="NGÀY QUÉT"
                                                                        Width="1.2*"
                                                                        SortMemberPath="ScannedAt"
                                                                        Binding="{Binding ScannedAtDisplay}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel x:Name="LibraryEmptyState"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Margin="0,12,0,0"
                                                    Visibility="Visible">
                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="{StaticResource CardCornerRadius}"
                                                    Background="{DynamicResource SurfaceEmptyBrush}"
                                                    HorizontalAlignment="Center">
                                                <controls:SvgIcon Source="assets/files.svg"
                                                                  Width="25"
                                                                  Height="25"
                                                                  Foreground="{DynamicResource TextIconBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="LibraryEmptyTitle"
                                                       Text="Thư mục này chưa có file PDF"
                                                       Margin="0,10,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="LibraryEmptyDescription"
                                                       Text="Các file PDF đã lưu sẽ xuất hiện tại đây."
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <TextBlock Text="Nhấp phải vào file PDF để xem các thao tác."
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="LibraryStatusText"
                                                       Text="Đang tải thư viện..."
                                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="●"
                           FontSize="10"
                           Margin="0,0,8,0"
                           Style="{StaticResource StatusMessageText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="{StaticResource CompactCaptionFontSize}"
                           Style="{StaticResource StatusMessageText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Style="{StaticResource StatusBarButton}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OpenAppSettings_Click"
                        ToolTip="Cài đặt QuickScan"
                        AutomationProperties.Name="Cài đặt ứng dụng">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Source="assets/geometric-settings.svg"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,6,0"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Cài đặt" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
