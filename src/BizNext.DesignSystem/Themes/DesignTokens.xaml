<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- LIGHT THEME - Semantic Design Tokens (Light theme) -->

    <!-- ACTION COLORS -->
    <SolidColorBrush x:Key="ActionPrimaryBrush" Color="#356AE6" />
    <SolidColorBrush x:Key="ActionPrimaryHoverBrush" Color="#2858C7" />
    <SolidColorBrush x:Key="ActionPrimarySubtleBrush" Color="#EAF0FF" />
    <SolidColorBrush x:Key="ActionDangerBrush" Color="#C44747" />

    <!-- TEXT COLORS -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#536078" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#748099" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSuccessBrush" Color="#278354" />
    <SolidColorBrush x:Key="TextDangerBrush" Color="#C44747" />
    <SolidColorBrush x:Key="TextWarningBrush" Color="#80530C" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#59667D" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#8A96AA" />
    <SolidColorBrush x:Key="TextIllustrationBrush" Color="#6C8CE8" />

    <!-- SURFACE COLORS (Backgrounds) -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SurfaceDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="SurfaceSuccessBrush" Color="#F0F7F2" />
    <SolidColorBrush x:Key="SurfaceHeaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfacePreviewBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#EAF0FF" />
    <SolidColorBrush x:Key="SurfaceEmptyBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="SurfaceWarningBrush" Color="#FFF7E8" />

    <!-- STATUS INDICATORS -->
    <SolidColorBrush x:Key="StatusDotBrush" Color="#35A66F" />

    <!-- BORDER COLORS -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="BorderHeaderBrush" Color="#E9EDF3" />
    <SolidColorBrush x:Key="BorderPreviewBrush" Color="#E8ECF3" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#356AE6" />
    <SolidColorBrush x:Key="BorderWarningBrush" Color="#F4D9A6" />

    <!-- SHAPE TOKENS -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <!-- DENSITY TOKENS - Compact -->
    <sys:Double x:Key="CompactControlHeight">36</sys:Double>
    <sys:Double x:Key="CompactSecondaryButtonHeight">34</sys:Double>
    <sys:Double x:Key="CompactPrimaryButtonHeight">38</sys:Double>
    <Thickness x:Key="CompactCardPadding">10</Thickness>
    <sys:Double x:Key="CompactSectionGap">12</sys:Double>
    <sys:Double x:Key="CompactFieldGap">12</sys:Double>
    <sys:Double x:Key="CompactLabelFontSize">10</sys:Double>
    <sys:Double x:Key="CompactControlFontSize">11</sys:Double>
    <sys:Double x:Key="CompactCaptionFontSize">10</sys:Double>

</ResourceDictionary>
