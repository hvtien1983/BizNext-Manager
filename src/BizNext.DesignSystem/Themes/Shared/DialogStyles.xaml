<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DIALOG / MODAL BACKING (ContentControl-based) [F2: Fluent 2 dialog] -->
    <!-- Note: Dialog is typically a Window with owner/modal behavior.
         This style is for a ContentControl overlay effect. For true dialog,
         use this as a base template in a custom Window class. -->

    <Style x:Key="Fluent.Dialog" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Dialog frame with rounded corners -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="Content" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DIALOG BUTTONS ROW (simple container for button alignment) -->
    <Style x:Key="Fluent.DialogButtonPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="Gap" Value="8" />
    </Style>

    <!-- Recommendation: For actual Window-based dialogs, use this in code-behind:
         1. Create a DialogWindow.xaml derived from Window
         2. Set WindowStyle="None" or custom frame
         3. Set Owner and ShowDialog() for modality
         4. Bind buttons to Commands in ViewModel
         5. Use Fluent.Button.Primary/Secondary styles for buttons
    -->

</ResourceDictionary>
