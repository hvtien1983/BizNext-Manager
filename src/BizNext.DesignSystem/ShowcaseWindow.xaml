<Window x:Class="BizNext.DesignSystem.ShowcaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluent 2 Component Showcase - BizNext Manager"
        Width="1200"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceCanvasBrush}">

    <!-- SHOWCASE PURPOSE: Verify all 14 Fluent 2 components in Light/Dark/High Contrast,
         state transitions (hover, focus, disabled), and accessibility. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOOLBAR: Theme toggle -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Gap="8">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold">
                    Theme:
                </TextBlock>
                <Button x:Name="LightThemeButton"
                        Style="{StaticResource Fluent.Button.Secondary}"
                        Padding="10,4">
                    Light
                </Button>
                <Button x:Name="DarkThemeButton"
                        Style="{StaticResource Fluent.Button.Secondary}"
                        Padding="10,4">
                    Dark
                </Button>
                <Button x:Name="HighContrastButton"
                        Style="{StaticResource Fluent.Button.Secondary}"
                        Padding="10,4">
                    High Contrast
                </Button>
                <Separator />
                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           FontSize="11">
                    Hover, Tab (focus), or disable controls to test states
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- SCROLLABLE COMPONENT GRID -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" Gap="24">

                <!-- SECTION 1: Input Controls -->
                <Border Background="{DynamicResource SurfaceDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Gap="12">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            1. INPUT CONTROLS
                        </TextBlock>

                        <!-- CheckBox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                CheckBox:
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Gap="16">
                                <CheckBox Style="{StaticResource Fluent.CheckBox}"
                                          Content="Unchecked" />
                                <CheckBox Style="{StaticResource Fluent.CheckBox}"
                                          Content="Checked"
                                          IsChecked="True" />
                                <CheckBox Style="{StaticResource Fluent.CheckBox}"
                                          Content="Disabled"
                                          IsEnabled="False" />
                                <CheckBox Style="{StaticResource Fluent.CheckBox}"
                                          Content="Indeterminate"
                                          IsChecked="{x:Null}" />
                            </StackPanel>
                        </Grid>

                        <!-- RadioButton -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                RadioButton:
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Gap="16">
                                <RadioButton Style="{StaticResource Fluent.RadioButton}"
                                             Content="Option 1"
                                             IsChecked="True" />
                                <RadioButton Style="{StaticResource Fluent.RadioButton}"
                                             Content="Option 2" />
                                <RadioButton Style="{StaticResource Fluent.RadioButton}"
                                             Content="Disabled"
                                             IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <!-- ComboBox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                ComboBox:
                            </TextBlock>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource Fluent.ComboBox}">
                                <ComboBoxItem>Option 1</ComboBoxItem>
                                <ComboBoxItem IsSelected="True">Option 2</ComboBoxItem>
                                <ComboBoxItem>Option 3</ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- ToggleButton -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                ToggleButton:
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Gap="8">
                                <ToggleButton Style="{StaticResource Fluent.ToggleButton}"
                                              Content="Off" />
                                <ToggleButton Style="{StaticResource Fluent.ToggleButton}"
                                              Content="On"
                                              IsChecked="True" />
                            </StackPanel>
                        </Grid>

                        <!-- TextBox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                TextBox:
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource InputTextBox}"
                                     Text="Sample text" />
                        </Grid>

                        <!-- PasswordBox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                PasswordBox:
                            </TextBlock>
                            <PasswordBox Grid.Column="1"
                                         Style="{StaticResource Fluent.PasswordBox}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Buttons -->
                <Border Background="{DynamicResource SurfaceDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Gap="12">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            2. BUTTONS
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Gap="8">
                            <Button Style="{StaticResource Fluent.Button.Primary}"
                                    Content="Primary" />
                            <Button Style="{StaticResource Fluent.Button.Secondary}"
                                    Content="Secondary" />
                            <Button Style="{StaticResource Fluent.Button.Subtle}"
                                    Content="Subtle" />
                            <Button Style="{StaticResource Fluent.Button.Primary}"
                                    Content="Disabled"
                                    IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Containers & Layout -->
                <Border Background="{DynamicResource SurfaceDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Gap="12">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            3. CONTAINERS & LAYOUT
                        </TextBlock>
                        <!-- TabControl -->
                        <TabControl Style="{StaticResource Fluent.TabControl}">
                            <TabItem Header="Tab 1" Style="{StaticResource Fluent.TabItem}">
                                <TextBlock Margin="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    Content for Tab 1
                                </TextBlock>
                            </TabItem>
                            <TabItem Header="Tab 2" Style="{StaticResource Fluent.TabItem}">
                                <TextBlock Margin="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    Content for Tab 2
                                </TextBlock>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: Feedback & Display -->
                <Border Background="{DynamicResource SurfaceDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Gap="12">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            4. FEEDBACK & DISPLAY
                        </TextBlock>

                        <!-- ProgressBar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center">
                                ProgressBar:
                            </TextBlock>
                            <ProgressBar Grid.Column="1"
                                         Style="{StaticResource Fluent.ProgressBar}"
                                         Value="65" />
                        </Grid>

                        <!-- Status Indicators -->
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                            Status Indicators:
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Gap="8">
                            <Border Style="{StaticResource Fluent.StatusIndicator.Success}">
                                <TextBlock Style="{StaticResource Fluent.StatusText.Success}"
                                           Text="✓ Success" />
                            </Border>
                            <Border Style="{StaticResource Fluent.StatusIndicator.Warning}">
                                <TextBlock Style="{StaticResource Fluent.StatusText.Warning}"
                                           Text="⚠ Warning" />
                            </Border>
                            <Border Style="{StaticResource Fluent.StatusIndicator.Error}">
                                <TextBlock Style="{StaticResource Fluent.StatusText.Error}"
                                           Text="✕ Error" />
                            </Border>
                        </StackPanel>

                        <!-- Tooltip -->
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                            Tooltip (hover over button):
                        </TextBlock>
                        <Button Style="{StaticResource Fluent.Button.Secondary}"
                                Content="Hover me"
                                ToolTip="This is a Fluent tooltip"
                                ToolTipService.InitialShowDelay="500" />
                    </StackPanel>
                </Border>

                <!-- SECTION 5: Navigation -->
                <Border Background="{DynamicResource SurfaceDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Gap="12">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            5. NAVIGATION MENU
                        </TextBlock>
                        <StackPanel Orientation="Vertical" Gap="4">
                            <RadioButton Style="{StaticResource Fluent.NavigationMenu.Item}"
                                         Content="Home"
                                         IsChecked="True" />
                            <RadioButton Style="{StaticResource Fluent.NavigationMenu.Item}"
                                         Content="Settings" />
                            <RadioButton Style="{StaticResource Fluent.NavigationMenu.Item}"
                                         Content="Help" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TESTING NOTES -->
                <Border Background="{DynamicResource SurfaceSubtleBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="12">
                    <StackPanel Gap="8">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            Testing Checklist:
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11">
                            ☐ Hover over controls → colors change (SurfaceHoverBrush)
                            ☐ Tab to focus → border stroke 2px (BorderFocusBrush)
                            ☐ Click buttons → Opacity 0.86 (pressed state)
                            ☐ Disable controls → Opacity 0.48
                            ☐ Light/Dark toggle → all colors swap via DynamicResource
                            ☐ High Contrast → SystemColors override (Windows OS setting)
                            ☐ Keyboard navigation → Tab/Shift+Tab/Arrow keys work
                            ☐ Screen reader → automation properties accessible
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
