<Application x:Class="BizNext.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Load BizNext.DesignSystem resources (includes themes, tokens, styles) -->
                <ResourceDictionary Source="pack://application:,,,/BizNext.DesignSystem;component/Themes/App.xaml" />

                <!-- Shell-specific resources -->
                <ResourceDictionary Source="Themes/ShellSpecific.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
