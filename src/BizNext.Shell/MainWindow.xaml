<Window x:Class="BizNext.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BizNext Manager"
        Width="1360"
        Height="820"
        MinWidth="1200"
        MinHeight="720"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/BizNext.Modules.QuickScan;component/Assets/icon.ico">
    <Window.Resources>
        <Style x:Key="SidebarNavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ActionPrimaryBrush}" />
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardModuleCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ActionPrimaryBrush}" />
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceHeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            Padding="4"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource SurfaceDefaultBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <Image Source="pack://application:,,,/BizNext.Modules.QuickScan;component/Assets/icon.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="BizNext Manager" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BizNext"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="Manager"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" KeyboardNavigation.TabNavigation="Local">
                    <RadioButton x:Name="DashboardNavigation"
                                 GroupName="Sidebar"
                                 Tag="dashboard"
                                 IsChecked="True"
                                 Style="{StaticResource SidebarNavigationButton}"
                                 Click="NavigationButton_Click"
                                 AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" Width="24" FontSize="17" />
                            <TextBlock Text="Tổng quan" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="TIỆN ÍCH"
                               Margin="12,18,0,6"
                               FontSize="{StaticResource CompactCaptionFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <RadioButton x:Name="QuickScanNavigation"
                                 GroupName="Sidebar"
                                 Tag="biznext.module.quickscan"
                                 Style="{StaticResource SidebarNavigationButton}"
                                 Click="NavigationButton_Click"
                                 AutomationProperties.Name="QuickScan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Width="24" FontSize="15" />
                            <TextBlock Text="QuickScan" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NotesNavigation"
                                 GroupName="Sidebar"
                                 Tag="biznext.module.notes"
                                 Style="{StaticResource SidebarNavigationButton}"
                                 Click="NavigationButton_Click"
                                 AutomationProperties.Name="Ghi chú">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" Width="24" FontSize="15" />
                            <TextBlock Text="Ghi chú" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WeatherNavigation"
                                 GroupName="Sidebar"
                                 Tag="biznext.module.weathercalendar"
                                 Style="{StaticResource SidebarNavigationButton}"
                                 Click="NavigationButton_Click"
                                 AutomationProperties.Name="Lịch và thời tiết">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Width="24" FontSize="15" />
                            <TextBlock Text="Lịch &amp; Thời tiết" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                    <Border Padding="12"
                            Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="Không gian làm việc"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                            <TextBlock Text="Các tiện ích BizNext ở cùng một nơi."
                                       Margin="0,4,0,0"
                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SidebarActionButton}"
                            Click="OpenDashboardSettings_Click"
                            AutomationProperties.Name="Cài đặt BizNext Manager">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙"
                                       Width="24"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Cài đặt"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceHeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ShellPageTitle"
                                   Text="Dashboard"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="ShellPageSubtitle"
                                   Text="Tập trung các tiện ích bạn cần mỗi ngày."
                                   Margin="0,3,0,0"
                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1">
                <ScrollViewer x:Name="DashboardHome" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chào mừng đến với BizNext Manager"
                                       FontSize="25"
                                       FontWeight="Bold" />
                            <TextBlock Text="Một Dashboard, nhiều tiện ích cho công việc hằng ngày."
                                       Margin="0,7,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <UniformGrid Grid.Row="2" Columns="3">
                            <Button Tag="biznext.module.quickscan"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource DashboardModuleCard}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Mở tiện ích QuickScan">
                                <StackPanel>
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource ActionPrimarySubtleBrush}">
                                        <TextBlock Text="▤"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource ActionPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="QuickScan"
                                               Margin="0,16,0,0"
                                               FontSize="16"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Quét tài liệu, tạo PDF và quản lý thư viện."
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="MỞ TIỆN ÍCH  →"
                                               Margin="0,18,0,0"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ActionPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Tag="biznext.module.notes"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource DashboardModuleCard}"
                                    Margin="4,0"
                                    AutomationProperties.Name="Mở tiện ích Ghi chú">
                                <StackPanel>
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource SurfaceEmptyBrush}">
                                        <TextBlock Text="✎"
                                                   FontSize="21"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Ghi chú"
                                               Margin="0,16,0,0"
                                               FontSize="16"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Lưu ý tưởng và việc cần làm."
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="MỞ TIỆN ÍCH  →"
                                               Margin="0,18,0,0"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ActionPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Tag="biznext.module.weathercalendar"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource DashboardModuleCard}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Mở tiện ích Lịch và Thời tiết">
                                <StackPanel>
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource SurfaceEmptyBrush}">
                                        <TextBlock Text="◷"
                                                   FontSize="21"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Lịch &amp; Thời tiết"
                                               Margin="0,16,0,0"
                                               FontSize="16"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Xem lịch trình và thời tiết."
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="MỞ TIỆN ÍCH  →"
                                               Margin="0,18,0,0"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ActionPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Border Grid.Row="4"
                                Padding="18"
                                Background="{DynamicResource SurfaceDefaultBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Không gian làm việc của bạn"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="Chọn một tiện ích ở bên trái hoặc mở QuickScan để bắt đầu quét tài liệu."
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
