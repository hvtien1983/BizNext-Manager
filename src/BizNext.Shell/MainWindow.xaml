<Window x:Class="BizNext.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BizNext Manager"
        Width="1360"
        Height="820"
        MinWidth="1200"
        MinHeight="720"
        Background="{DynamicResource SurfaceCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceHeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            Padding="4"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource SurfaceDefaultBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <Image Source="pack://application:,,,/BizNext.Modules.QuickScan;component/Assets/icon.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="BizNext Manager" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BizNext"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="Manager"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" KeyboardNavigation.TabNavigation="Local">
                    <RadioButton x:Name="DashboardNavigation"
                                 GroupName="Sidebar"
                                 Tag="dashboard"
                                 IsChecked="True"
                                 Style="{StaticResource SidebarNavigationButton}"
                                 Click="NavigationButton_Click"
                                 AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" Width="24" FontSize="17" />
                            <TextBlock Text="Tổng quan" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="TIỆN ÍCH"
                               Margin="12,18,0,6"
                               FontSize="{StaticResource CompactCaptionFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ListBox x:Name="SidebarModuleList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="SidebarModuleList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Nav"
                                                    Background="Transparent"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Padding="14,11"
                                                    Margin="0,3">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Nav" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ActionPrimaryBrush}" />
                                                    <Setter TargetName="Nav" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Metadata.Icon}" Width="24" FontSize="15" />
                                    <TextBlock Text="{Binding Metadata.Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                    <Border Padding="12"
                            Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="Không gian làm việc"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                            <TextBlock Text="Các tiện ích BizNext ở cùng một nơi."
                                       Margin="0,4,0,0"
                                       FontSize="{StaticResource CompactCaptionFontSize}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SidebarActionButton}"
                            Click="OpenDashboardSettings_Click"
                            AutomationProperties.Name="Cài đặt BizNext Manager">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙"
                                       Width="24"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Cài đặt"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceHeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ShellPageTitle"
                                   Text="Dashboard"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="ShellPageSubtitle"
                                   Text="Tập trung các tiện ích bạn cần mỗi ngày."
                                   Margin="0,3,0,0"
                                   FontSize="{StaticResource CompactCaptionFontSize}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1">
                <ScrollViewer x:Name="DashboardHome" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chào mừng đến với BizNext Manager"
                                       FontSize="25"
                                       FontWeight="Bold" />
                            <TextBlock Text="Một Dashboard, nhiều tiện ích cho công việc hằng ngày."
                                       Margin="0,7,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <ItemsControl x:Name="DashboardCards" Grid.Row="2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DashboardModuleCard}"
                                            Margin="0,0,8,0"
                                            Click="ModuleCard_Click"
                                            AutomationProperties.Name="{Binding Metadata.Name}">
                                        <StackPanel>
                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Background="{DynamicResource ActionPrimarySubtleBrush}">
                                                <TextBlock Text="{Binding Metadata.Icon}"
                                                           FontSize="22"
                                                           Foreground="{DynamicResource ActionPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Metadata.Name}"
                                                       Margin="0,16,0,0"
                                                       FontSize="16"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="{Binding Metadata.Description}"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="MỞ TIỆN ÍCH  →"
                                                       Margin="0,18,0,0"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ActionPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Row="4"
                                Padding="18"
                                Background="{DynamicResource SurfaceDefaultBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Không gian làm việc của bạn"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="Chọn một tiện ích ở bên trái hoặc mở QuickScan để bắt đầu quét tài liệu."
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
